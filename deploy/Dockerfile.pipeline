# Image for the one-shot `pipeline` service in deploy/docker-compose.yml: loads a seed into Postgres
# and OpenSearch, and can run the model stages. The repo is bind-mounted at /repo, not copied.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils curl \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /repo
ENTRYPOINT []
