                "maximum": 9007199254740991
              },
              "short_url": {
                "type": "string",
                "format": "uri"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "page",
              "short_url",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "next_page": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "doc",
        "agency",
        "volume",
        "box",
        "page_count",
        "machine_extracted_title",
        "machine_extracted_summary",
        "short_url",
        "url",
        "official_url",
        "pdf_url",
        "pages",
        "next_page"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
