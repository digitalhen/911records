[
  {
    "name": "search_records",
    "description": "Search record pages. Filters use exact catalog/index values. Returns page citations and machine-extracted titles, not full text; use get_page to read evidence. Results use the website’s hybrid search when embeddings are available.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "agency": {
          "type": "string",
          "maxLength": 300
        },
        "volume": {
          "type": "string",
          "maxLength": 300
        },
        "box": {
          "type": "string",
          "maxLength": 300
        },
        "folder": {
          "type": "string",
          "maxLength": 300
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "contaminant": {
          "type": "string",
          "maxLength": 300
        },
        "lab": {
          "type": "string",
          "maxLength": 300
        },
        "year": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doc": {
                "type": "string",
                "pattern": "^NYC-WTC_\\d{9}$"
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "bates": {
                "type": "string",
                "pattern": "^NYC-WTC_\\d{9}$"
              },
              "agency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "machine_extracted_title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "short_url": {
                "type": "string",
                "format": "uri"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "doc",
              "page",
              "bates",
              "agency",
              "machine_extracted_title",
              "short_url",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "indexed_page_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Indexed pages, not unique documents; may lag catalog removals."
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "next_page": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "hits",
        "indexed_page_total",
        "page",
        "next_page",
        "semantic",
        "note"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_document",
    "description": "Get document metadata and a paginated list of its pages. Machine-extracted titles and summaries are not source evidence.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "start_page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "doc"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "agency": {
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "type": [
            "string",
            "null"
          ]
        },
        "box": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "machine_extracted_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine_extracted_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "short_url": {
          "type": "string",
          "format": "uri"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "official_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "pdf_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
