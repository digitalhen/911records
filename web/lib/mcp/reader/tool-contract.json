  {
    "name": "get_page",
    "description": "Read one page with its exact Bates citation and scan link. Long OCR text is paginated by character offset; follow next_offset to retrieve the rest.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "max_chars": {
          "default": 12000,
          "type": "integer",
          "minimum": 100,
          "maximum": 20000
        }
      },
      "required": [
        "doc",
        "page"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "bates": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "text": {
          "type": "string",
          "description": "OCR excerpt; verify against the source scan."
        },
        "text_available": {
          "type": "boolean"
        },
        "ocr_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Next character or list offset; null when complete."
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "short_url": {
          "type": "string",
          "format": "uri"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "scan_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "official_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "doc",
        "page",
        "bates",
        "text",
        "text_available",
        "ocr_source",
        "offset",
        "next_offset",
        "total_chars",
        "short_url",
        "url",
        "scan_url",
        "official_url",
        "note"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "browse_collection",
    "description": "List documents in Bates order, optionally filtered by exact agency, volume, box, or folder. Follow next_after for more. Folder labels are omitted because they may contain private names.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "agency": {
          "type": "string",
          "maxLength": 300
        },
        "volume": {
          "type": "string",
          "maxLength": 300
        },
        "box": {
          "type": "string",
          "maxLength": 300
        },
        "folder": {
          "type": "string",
          "maxLength": 300
        },
        "after": {
          "type": "string",
          "pattern": "^NYC-WTC_\\d{9}$"
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doc": {
                "type": "string",
                "pattern": "^NYC-WTC_\\d{9}$"
              },
              "agency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "volume": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "box": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "page_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "short_url": {
                "type": "string",
                "format": "uri"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "doc",
              "agency",
              "volume",
              "box",
              "page_count",
              "short_url",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "next_after": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^NYC-WTC_\\d{9}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pass as after to retrieve the next batch; null when complete."
        }
      },
      "required": [
        "documents",
        "next_after"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_changes",
    "description": "List catalog changes, newest first, optionally since a capture date (inclusive). Dates are mirror observations, not document dates. Returns only identifiers and change types.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Catalog capture date, not document date."
              },
              "doc": {
                "type": "string",
                "pattern": "^NYC-WTC_\\d{9}$"
              },
              "kind": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "short_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "date",
              "doc",
              "kind",
              "url",
              "short_url"
            ],
            "additionalProperties": false
          }
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Next character or list offset; null when complete."
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "changes",
        "next_offset",
        "note"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]
